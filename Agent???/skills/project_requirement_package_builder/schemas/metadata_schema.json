{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "project_requirement_package metadata",
  "description": "输出资料包的项目级元数据（metadata.json）",
  "type": "object",
  "required": [
    "project_name",
    "customer_name",
    "region",
    "industry",
    "vehicle_models",
    "vehicle_count",
    "source_files",
    "generated_at",
    "skill_version",
    "language"
  ],
  "properties": {
    "project_name": { "type": "string", "description": "项目名称；资料未明确时填“未在资料中明确提供”或由 CLI --project-name 指定" },
    "customer_name": { "type": "string", "description": "客户名称；资料未明确时标注" },
    "region": { "type": "string", "description": "区域/国家/城市" },
    "industry": { "type": "string", "description": "行业" },
    "project_phase": { "type": "string", "description": "项目阶段（如：签单后/PO 前/二期等）" },
    "vehicle_models": {
      "type": "array",
      "items": { "type": "string" },
      "description": "资料中出现的车型型号列表"
    },
    "vehicle_count": { "type": ["string", "integer"], "description": "车辆数量；未明确时为字符串标注" },
    "source_files": {
      "type": "array",
      "description": "本次读取的源文件清单",
      "items": {
        "type": "object",
        "required": ["file", "type", "parse_status"],
        "properties": {
          "file": { "type": "string" },
          "type": { "type": "string" },
          "parse_status": { "type": "string", "enum": ["ok", "partial", "failed", "skipped_media", "skipped_unsupported"] },
          "note": { "type": "string" }
        }
      }
    },
    "generated_at": { "type": "string", "description": "ISO8601 生成时间" },
    "skill_version": { "type": "string" },
    "language": { "type": "string", "const": "zh-CN" },
    "confidence_notes": { "type": "string", "description": "整体可信度说明（可选）" }
  }
}
